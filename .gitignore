# Caché intermedia de Manim: SVGs de Tex, movimientos parciales y renders.
# Se regenera con `manim -qh --media_dir circuitos/media ...`, así que no vale
# la pena versionarla. Los .mp4 terminados sí van, en presentaciones/clips/.
presentaciones/circuitos/media/

__pycache__/
*.pyc

# Historial local del editor (VS Code Local History). Trae su propio .git
# dentro, que como subdirectorio rompería el repositorio.
.history/

# Locks de KiCad: los crea al abrir un archivo y los borra al cerrarlo. Si se
# versionan, cada sesión de edición ensucia el status con basura transitoria.
*.lck
